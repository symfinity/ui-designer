{% set contrast_failures = 0 %}
{% if contrast_panel.available|default(false) %}
    {% for row in contrast_panel.rows|default([]) %}
        {% if not row.pass %}
            {% set contrast_failures = contrast_failures + 1 %}
        {% endif %}
    {% endfor %}
{% endif %}

<header class="ui-designer-drawer__header">
    <div class="ui-designer-drawer__title-row">
        <h2 class="ui-designer-drawer__title">UI Designer</h2>
        <div class="ui-designer-drawer__title-actions">
            {# v0.2.x+: reset draft — not wired in 0.1.x
            <button type="button"
                    class="ui-designer-drawer__icon-btn"
                    data-drawer-action="reset"
                    disabled
                    title="Reset draft — coming soon"
                    aria-label="Reset theme">↺</button>
            #}
            <form method="post"
                  action="{{ path('ui_designer_drawer_close') }}"
                  class="ui-designer-drawer__close-form"
                  data-controller="csrf-protection"
                  data-turbo="false">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                <input type="hidden" name="return_url" value="{{ host_return_url|default(current_path|default('/')) }}">
                <button type="submit" class="ui-designer-drawer__icon-btn" aria-label="Close drawer">×</button>
            </form>
        </div>
    </div>

    <div class="ui-designer-drawer__copy-row">
        <button type="button" class="ui-designer-drawer__copy-btn" data-drawer-action="copy">
            <span aria-hidden="true">⎘</span> Copy
        </button>
        <button type="button"
                class="ui-designer-drawer__icon-action"
                data-drawer-action="undo"
                {% if not can_undo %} disabled{% endif %}
                title="Undo"
                aria-label="Undo">↶</button>
        {# v0.2.x+: redo stack — not wired in 0.1.x
        <button type="button"
                class="ui-designer-drawer__icon-action"
                disabled
                title="Redo — not available yet"
                aria-label="Redo">↷</button>
        #}
    </div>

    <div class="ui-designer-drawer__control-block">
        <span class="ui-designer-drawer__control-label">Mode</span>
        <div class="ui-designer-drawer__mode ui-designer-drawer__mode--wide" role="group" aria-label="Preview mode">
            <button type="button"
                    id="drawer-mode-light"
                    class="{% if preview_mode != 'dark' %}is-active{% endif %}"
                    data-drawer-mode="light"
                    {% if not has_dark_variant %}disabled title="No dark companion"{% endif %}>
                <span aria-hidden="true">☀</span> Light
            </button>
            <button type="button"
                    id="drawer-mode-dark"
                    class="{% if preview_mode == 'dark' %}is-active{% endif %}"
                    data-drawer-mode="dark"
                    {% if not has_dark_variant %}disabled{% endif %}>
                <span aria-hidden="true">☾</span> Dark
            </button>
        </div>
    </div>

    {# 0.5.x/0.6.x+: design system style + icon library — not wired in 0.1.x
    <div class="ui-designer-drawer__control-grid">
        <div class="ui-designer-drawer__control-block">
            <span class="ui-designer-drawer__control-label" id="drawer-style-label">Style</span>
            <div class="ui-designer-drawer__readout"
                 role="status"
                 aria-labelledby="drawer-style-label"
                 title="Design system style — editable in a later release">
                {{ draft.designSystemId|default('default')|replace({'_': ' '})|title }}
            </div>
        </div>
        <div class="ui-designer-drawer__control-block">
            <span class="ui-designer-drawer__control-label" id="drawer-icon-library-label">Icon library</span>
            {% if ux_icons_installed %}
                <select id="drawer-icon-library"
                        class="ui-designer-drawer__control-select"
                        data-drawer-icon-library
                        aria-labelledby="drawer-icon-library-label">
                    {% for set in ux_icons.sets|default([]) %}
                        <option value="{{ set.id }}"{% if loop.first %} selected{% endif %}>{{ set.label }}</option>
                    {% endfor %}
                </select>
            {% else %}
                <div class="ui-designer-drawer__readout ui-designer-drawer__readout--muted"
                     id="drawer-icon-library"
                     role="status"
                     aria-labelledby="drawer-icon-library-label"
                     aria-describedby="drawer-icon-library-hint">
                    symfony/ux-icons not installed
                </div>
            {% endif %}
        </div>
    </div>
    <p class="ui-designer-drawer__control-hint" id="drawer-icon-library-hint"{% if ux_icons_installed %} hidden{% endif %}>
        Install <code>symfony/ux-icons</code> in the consumer app to pick an icon set.
    </p>
    #}

    {# 0.5.x/0.6.x: mono tone + menu chrome — not wired (use Presets dropdown + Colors tab)
    {% set active_preset_label = active_preset_id|default('') %}
    {% for preset in presets|default([]) %}
        {% if preset.id == active_preset_id %}
            {% set active_preset_label = preset.label %}
        {% endif %}
    {% endfor %}
    <div class="ui-designer-drawer__control-grid">
        <div class="ui-designer-drawer__control-block">
            <span class="ui-designer-drawer__control-label" id="drawer-base-color-label">Base color</span>
            <div class="ui-designer-drawer__readout"
                 role="status"
                 aria-labelledby="drawer-base-color-label"
                 title="Mono tone — editable in a later release">
                {{ full_palette.activeTone|default('neutral')|title }}
            </div>
        </div>
        <div class="ui-designer-drawer__control-block">
            <span class="ui-designer-drawer__control-label" id="drawer-theme-preset-label">Theme</span>
            <div class="ui-designer-drawer__readout"
                 role="status"
                 aria-labelledby="drawer-theme-preset-label"
                 title="Active preset — switch via Presets below">
                {{ active_preset_label }}
            </div>
        </div>
    </div>
    <div class="ui-designer-drawer__control-grid">
        <div class="ui-designer-drawer__control-block">
            <span class="ui-designer-drawer__control-label" id="drawer-menu-color-label">Menu color</span>
            <div class="ui-designer-drawer__readout"
                 role="status"
                 aria-labelledby="drawer-menu-color-label"
                 title="Sidebar menu chrome — editable in a later release">
                Default / Solid
            </div>
        </div>
        <div class="ui-designer-drawer__control-block">
            <span class="ui-designer-drawer__control-label" id="drawer-menu-accent-label">Menu accent</span>
            <div class="ui-designer-drawer__readout"
                 role="status"
                 aria-labelledby="drawer-menu-accent-label"
                 title="Sidebar menu accent — editable in a later release">
                Bold
            </div>
        </div>
    </div>
    <p class="ui-designer-drawer__control-hint" id="drawer-header-readonly-hint">
        Style, base tone, and menu chrome are read-only here — use <strong>Presets</strong> below or edit live tokens in <strong>Colors</strong> and <strong>Other</strong>.
    </p>
    #}

    <div class="ui-designer-drawer__presets">
        <div class="ui-designer-drawer__presets-head">
            <span class="ui-designer-drawer__control-label">Presets</span>
            <div class="ui-designer-drawer__presets-actions">
                <a href="{{ path('ui_designer_import_hub') }}" class="ui-designer-drawer__presets-icon" title="Import preset">⎘</a>
                {# v0.5.x+: random preset — not wired in 0.1.x
                <button type="button" class="ui-designer-drawer__presets-icon" disabled title="Random preset — coming soon">🎲</button>
                #}
                <button type="button"
                        class="ui-designer-drawer__presets-icon{% if contrast_failures > 0 %} has-badge{% endif %}"
                        data-drawer-action="contrast"
                        title="Contrast check"
                        aria-label="Contrast check{% if contrast_failures > 0 %} — {{ contrast_failures }} issue(s){% endif %}">
                    ◐
                    {% if contrast_failures > 0 %}
                        <span class="ui-designer-drawer__badge">{{ contrast_failures }}</span>
                    {% endif %}
                </button>
            </div>
        </div>
        <form method="post" action="{{ path('ui_designer_studio_load') }}" class="ui-designer-drawer__preset-form">
            <select name="theme_id" class="ui-designer-drawer__control-select ui-designer-drawer__preset-select" aria-label="Load preset">
                {% for preset in presets %}
                    <option value="{{ preset.id }}"{% if preset.id == active_preset_id %} selected{% endif %}>{{ preset.label }}</option>
                {% endfor %}
            </select>
            <button type="submit" class="ui-designer-drawer__preset-load" hidden aria-hidden="true">Load</button>
        </form>
    </div>

    {% if current_path is defined %}
        <p class="ui-designer-drawer__route" data-ui-designer-route-label>{{ current_path }}</p>
    {% endif %}

    <div id="drawer-contrast-panel"
         class="ui-designer-drawer__contrast-panel"
         hidden
         role="region"
         aria-label="Contrast check">
        {% if contrast_panel.available|default(false) %}
            <ul class="ui-designer-drawer__contrast-list">
                {% for row in contrast_panel.rows %}
                    <li class="{% if row.pass %}pass{% else %}fail{% endif %}">
                        {{ row.foreground }} on {{ row.background }}:
                        {% if row.ratio %}{{ row.ratio|number_format(2) }}{% else %}—{% endif %}
                        ({{ row.level }})
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="ui-designer-drawer__hint">{{ contrast_panel.notice|default('Contrast unavailable.') }}</p>
        {% endif %}
    </div>
</header>
