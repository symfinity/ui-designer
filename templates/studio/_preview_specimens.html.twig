<div class="ui-designer-specimens" data-theme="{{ draft.id ?? 'semantic' }}">
    <div class="ui-designer-specimen" data-studio-marker="button-primary">
        <button type="button" class="btn btn-primary">Primary button</button>
    </div>
    <div class="ui-designer-specimen" data-studio-marker="card-surface">
        <article class="card">
            <h3>Card specimen</h3>
            <p class="text-muted">Preview surface, text, and border tokens.</p>
        </article>
    </div>
    <div class="ui-designer-specimen" data-studio-marker="danger-badge">
        <span class="badge badge-danger">Danger</span>
    </div>
</div>
